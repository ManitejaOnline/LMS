generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

/// Infrastructure metadata (retained from foundation).
model PrismaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("prisma_meta")
}

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users User[]
  assignmentRules CourseAssignmentRule[]

  @@index([name])
  @@index([deletedAt])
  @@map("departments")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  employeeCode      String?    @unique @map("employee_code")
  phone             String?
  role              AppRole    @default(EMPLOYEE)
  status            UserStatus @default(ACTIVE)
  departmentId      String?    @map("department_id")
  managerId         String?    @map("manager_id")
  lastLoginAt       DateTime?  @map("last_login_at")
  passwordChangedAt DateTime?  @map("password_changed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  department          Department?          @relation(fields: [departmentId], references: [id])
  manager             User?                @relation("UserManager", fields: [managerId], references: [id])
  directReports       User[]               @relation("UserManager")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  createdCourses      Course[]             @relation("CourseCreator")
  uploadedMedia       MediaAsset[]         @relation("MediaUploader")
  assignmentRules     CourseAssignmentRule[] @relation("AssignmentRuleUser")
  courseAssignments   CourseAssignment[]
  lessonProgress      LessonProgress[]
  pageProgress        PageProgress[]
  learningEvents      LearningEvent[]
  quizAttempts        QuizAttempt[]
  notifications       Notification[]

  @@index([role])
  @@index([status])
  @@index([departmentId])
  @@index([managerId])
  @@index([deletedAt])
  @@index([lastName, firstName])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  PDF
  VIDEO
  QUIZ
}

enum MediaKind {
  THUMBNAIL
  DOCUMENT
  VIDEO
}

enum AssignmentRuleTargetType {
  ALL_EMPLOYEES
  DEPARTMENT
  EMPLOYEE
}

model MediaAsset {
  id           String    @id @default(cuid())
  kind         MediaKind
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  storagePath  String    @map("storage_path")
  publicUrl    String    @map("public_url")
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  uploadedBy         User?    @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  courseThumbnails   Course[] @relation("CourseThumbnail")
  lessonsAsContent   Lesson[] @relation("LessonContentMedia")

  @@index([kind])
  @@index([deletedAt])
  @@map("media_assets")
}

model Course {
  id               String       @id @default(cuid())
  title            String
  code             String       @unique
  description      String?
  status           CourseStatus @default(DRAFT)
  isMandatory      Boolean      @default(true) @map("is_mandatory")
  estimatedMinutes Int?         @map("estimated_minutes")
  thumbnailMediaId String?      @map("thumbnail_media_id")
  createdById      String?      @map("created_by_id")
  publishedAt      DateTime?    @map("published_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  thumbnailMedia  MediaAsset?            @relation("CourseThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  createdBy       User?                  @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  modules         CourseModule[]
  assignmentRules CourseAssignmentRule[]
  assignments     CourseAssignment[]

  @@index([status])
  @@index([title])
  @@index([deletedAt])
  @@map("courses")
}

model CourseModule {
  id          String    @id @default(cuid())
  courseId    String    @map("course_id")
  title       String
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
  @@index([deletedAt])
  @@map("course_modules")
}

model Lesson {
  id             String     @id @default(cuid())
  moduleId       String     @map("module_id")
  title          String
  description    String?
  type           LessonType
  sortOrder      Int        @default(0) @map("sort_order")
  contentMediaId String?    @map("content_media_id")
  durationSeconds Int?      @map("duration_seconds")
  quizConfig     Json?      @map("quiz_config")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  module       CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contentMedia MediaAsset?  @relation("LessonContentMedia", fields: [contentMediaId], references: [id], onDelete: SetNull)
  progress     LessonProgress[]
  pageProgress PageProgress[]
  learningEvents LearningEvent[]
  quiz         Quiz?

  @@index([moduleId, sortOrder])
  @@index([type])
  @@index([deletedAt])
  @@map("lessons")
}

model CourseAssignmentRule {
  id           String                   @id @default(cuid())
  courseId     String                   @map("course_id")
  targetType   AssignmentRuleTargetType @map("target_type")
  departmentId String?                  @map("department_id")
  userId       String?                  @map("user_id")
  dueInDays    Int?                     @map("due_in_days")
  isActive     Boolean                  @default(true) @map("is_active")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  deletedAt    DateTime?                @map("deleted_at")

  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user       User?       @relation("AssignmentRuleUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([targetType])
  @@index([deletedAt])
  @@map("course_assignment_rules")
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LearningEventType {
  LESSON_OPENED
  LESSON_COMPLETED
  READING_TIME
  PAGE_VIEW
  SCROLL
  RESUME_POSITION
  VIDEO_PLAY
  VIDEO_PAUSE
  VIDEO_SEEK
  VIDEO_SPEED
  VIDEO_PROGRESS
  TAB_HIDDEN
  TAB_VISIBLE
  WINDOW_BLUR
  WINDOW_FOCUS
  IDLE_START
  IDLE_END
  PAGE_STARTED
  PAGE_COMPLETED
  PAGE_PAUSED
  PAGE_RESUMED
  PAGE_CHANGED
  IDLE
  RETURNED
  RIGHT_CLICK_BLOCKED
  COPY_BLOCKED
  PRINT_BLOCKED
  SELECT_ALL_BLOCKED
  SCREENSHOT_ATTEMPT
  DEVTOOLS_OPENED
  DEVTOOLS_CLOSED
  FULLSCREEN_EXIT
  SAVE_BLOCKED
}

model CourseAssignment {
  id              String           @id @default(cuid())
  courseId        String           @map("course_id")
  userId          String           @map("user_id")
  ruleId          String?          @map("rule_id")
  status          AssignmentStatus @default(NOT_STARTED)
  dueAt           DateTime?        @map("due_at")
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  progressPercent Int              @default(0) @map("progress_percent")
  lastLessonId    String?          @map("last_lesson_id")
  assignedAt      DateTime         @default(now()) @map("assigned_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
  pageProgress PageProgress[]
  events       LearningEvent[]
  quizAttempts QuizAttempt[]

  @@unique([courseId, userId])
  @@index([userId, status])
  @@index([courseId])
  @@index([dueAt])
  @@index([deletedAt])
  @@map("course_assignments")
}

model LessonProgress {
  id                String               @id @default(cuid())
  assignmentId      String               @map("assignment_id")
  lessonId          String               @map("lesson_id")
  userId            String               @map("user_id")
  status            LessonProgressStatus @default(NOT_STARTED)
  currentPage       Int?                 @map("current_page")
  totalPages        Int?                 @map("total_pages")
  visitedPages      Json?                @map("visited_pages")
  scrollPercentage  Float?               @map("scroll_percentage")
  resumePositionSec Float?               @map("resume_position_sec")
  readingTimeSec    Int                  @default(0) @map("reading_time_sec")
  watchPercentage   Float?               @map("watch_percentage")
  idleTimeSec       Int                  @default(0) @map("idle_time_sec")
  lastPlaybackSpeed Float?               @map("last_playback_speed")
  startedAt         DateTime?            @map("started_at")
  completedAt       DateTime?            @map("completed_at")
  lastEventAt       DateTime?            @map("last_event_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  assignment CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// Per-page PDF reading compliance progress (anti-skip timer).
model PageProgress {
  id                String    @id @default(cuid())
  assignmentId      String    @map("assignment_id")
  lessonId          String    @map("lesson_id")
  userId            String    @map("user_id")
  pageNumber        Int       @map("page_number")
  requiredSeconds   Int       @default(60) @map("required_seconds")
  completedSeconds  Int       @default(0) @map("completed_seconds")
  completed         Boolean   @default(false)
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  pauseCount        Int       @default(0) @map("pause_count")
  totalPausedSec    Int       @default(0) @map("total_paused_sec")
  focusLostCount    Int       @default(0) @map("focus_lost_count")
  tabSwitchCount    Int       @default(0) @map("tab_switch_count")
  hiddenCount       Int       @default(0) @map("hidden_count")
  idleCount         Int       @default(0) @map("idle_count")
  lastHeartbeatAt   DateTime? @map("last_heartbeat_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  assignment CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, lessonId, pageNumber])
  @@index([userId, lessonId])
  @@index([assignmentId, lessonId])
  @@map("page_progress")
}

model LearningEvent {
  id           String            @id @default(cuid())
  assignmentId String            @map("assignment_id")
  lessonId     String?           @map("lesson_id")
  userId       String            @map("user_id")
  eventType    LearningEventType @map("event_type")
  payload      Json?
  clientEventId String?          @unique @map("client_event_id")
  occurredAt   DateTime          @map("occurred_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  assignment CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lesson     Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId, occurredAt])
  @@index([userId, occurredAt])
  @@index([eventType])
  @@map("learning_events")
}

model Quiz {
  id               String   @id @default(cuid())
  lessonId         String   @unique @map("lesson_id")
  title            String?
  passingScore     Int      @default(70) @map("passing_score")
  questionCount    Int      @default(5) @map("question_count")
  maxAttempts      Int      @default(3) @map("max_attempts")
  shuffleQuestions Boolean  @default(true) @map("shuffle_questions")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id        String   @id @default(cuid())
  quizId    String   @map("quiz_id")
  prompt    String
  sortOrder Int      @default(0) @map("sort_order")
  points    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  quiz     Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options  QuizOption[]
  answers  QuizAttemptAnswer[]

  @@index([quizId, sortOrder])
  @@map("quiz_questions")
}

model QuizOption {
  id         String @id @default(cuid())
  questionId String @map("question_id")
  label      String
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @default(0) @map("sort_order")

  question QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAttemptAnswer[]

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id            String    @id @default(cuid())
  quizId        String    @map("quiz_id")
  assignmentId  String    @map("assignment_id")
  userId        String    @map("user_id")
  attemptNumber Int       @map("attempt_number")
  score         Int?
  passed        Boolean?
  startedAt     DateTime  @default(now()) @map("started_at")
  submittedAt   DateTime? @map("submitted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  quiz       Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignment CourseAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    QuizAttemptAnswer[]

  @@unique([quizId, assignmentId, attemptNumber])
  @@index([userId])
  @@index([assignmentId])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String  @map("attempt_id")
  questionId String  @map("question_id")
  optionId   String  @map("option_id")
  isCorrect  Boolean @map("is_correct")

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_attempt_answers")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  body      String
  type      String
  metadata  Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}
