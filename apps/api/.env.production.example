# Copy to Railway service variables (do not commit secrets).
# Also add a Railway Postgres plugin and use its DATABASE_URL.

NODE_ENV=production
APP_NAME=zebl-lms-api
APP_PORT=3000
APP_GLOBAL_PREFIX=api/v1
# Comma-separated list of Vercel frontend origins
APP_CORS_ORIGINS=https://lms-api-ten.vercel.app

# Set by Railway Postgres plugin — or paste manually:
# DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB?schema=public

JWT_ACCESS_SECRET=replace-with-long-random-access-secret-min-32
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=info
LOG_PRETTY=false

SWAGGER_ENABLED=false
SWAGGER_PATH=docs

BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_EXPIRES_MINUTES=30
SEED_SUPER_ADMIN_EMAIL=superadmin@zebl.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!SuperAdmin1

STORAGE_ROOT_DIR=uploads
STORAGE_PUBLIC_BASE_URL=/uploads
UPLOAD_MAX_THUMBNAIL_BYTES=5000000
UPLOAD_MAX_DOCUMENT_BYTES=50000000
UPLOAD_MAX_VIDEO_BYTES=500000000
