# Environment
NODE_ENV=development
APP_NAME=zebl-lms-api
APP_PORT=3000
APP_GLOBAL_PREFIX=api/v1
APP_CORS_ORIGINS=http://localhost:4200

# Database
# Docker Compose maps container 5432 → host 5433 (avoids Windows PostgreSQL clash)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/zebl_lms?schema=public

# JWT (change in every environment — never commit real secrets)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Auth
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_EXPIRES_MINUTES=30
SEED_SUPER_ADMIN_EMAIL=superadmin@zebl.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!SuperAdmin1

# Storage / uploads
STORAGE_ROOT_DIR=uploads
STORAGE_PUBLIC_BASE_URL=/uploads
UPLOAD_MAX_THUMBNAIL_BYTES=5000000
UPLOAD_MAX_DOCUMENT_BYTES=50000000
UPLOAD_MAX_VIDEO_BYTES=500000000
